// --- Flag - ISO 3611 Flags ---

#define FLAG(id) \
    spriteset(sprite_flag_ ## id, format_string("gfx/flag/%s.xpm", #id)) { \
        [0, 0] \
    } \
    item (FEAT_BADGES, flag_ ## id) {              \
        property {                                 \
            label: format_string("flag/%s", #id);  \
            name:  string(STR_FLAG_ ## id);        \
        }                                          \
        graphics {                                 \
            default: sprite_flag_ ## id ;          \
        }                                          \
    }

